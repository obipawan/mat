import { test } from "node:test";
import assert from "node:assert/strict";
import {
  ACTIONS, normalizeChord, defaultBinds, findConflict, canUnbind, hyprBindLines, bindsConf, niriSnippet, swaySnippet,
} from "../../shell/lib/keybinds.mjs";

test("ACTIONS: 20 actions in 01-architecture.md §7 order", () => {
  assert.equal(ACTIONS.length, 20); assert.equal(ACTIONS[0].id, "toggleLauncher"); assert.equal(ACTIONS[19].id, "brightnessDown");
});

test("normalizeChord: modifier order, aliases, letter case", () => {
  assert.equal(normalizeChord("shift+super+s"), "Shift+Super+S");
  assert.equal(normalizeChord("Mod4+,"), "Super+Comma");
  assert.equal(normalizeChord("control+alt+Tab"), "Ctrl+Alt+Tab");
  assert.equal(normalizeChord("esc"), "Escape");
});

test("findConflict: another action with the chord, or null for the same action", () => {
  assert.equal(findConflict(defaultBinds(), "Super+A", "toggleMedia"), "toggleControlCenter");
  assert.equal(findConflict(defaultBinds(), "Super+A", "toggleControlCenter"), null);
});

test("canUnbind: core actions cannot be unbound", () => {
  assert.equal(canUnbind("togglePower"), false); assert.equal(canUnbind("toggleMedia"), true);
});

test("hyprBindLines: modifiers, bare keys, lone Super, key names, repeat", () => {
  assert.deepEqual(hyprBindLines("toggleCapture", "Super+Shift+S"), ["bind = SUPER SHIFT, S, global, mat-shell:toggleCapture"]);
  assert.deepEqual(hyprBindLines("toggleCapture", "Print"), ["bind = , Print, global, mat-shell:toggleCapture"]);
  assert.deepEqual(hyprBindLines("toggleLauncher", "Super"), ["bindr = SUPER, Super_L, global, mat-shell:toggleLauncher"]);
  assert.deepEqual(hyprBindLines("openSettings", "Super+Comma"), ["bind = SUPER, comma, global, mat-shell:openSettings"]);
  assert.deepEqual(hyprBindLines("volumeUp", "XF86AudioRaiseVolume"), ["binde = , XF86AudioRaiseVolume, global, mat-shell:volumeUp"]);
});

test("bindsConf: header and trailing newline", () => {
  const conf = bindsConf(defaultBinds());
  assert.ok(conf.startsWith("# Generated by mat-shell KeybindService")); assert.ok(conf.endsWith("\n"));
});

test("swaySnippet: IPC lines with arguments", () => {
  assert.ok(swaySnippet(defaultBinds()).includes("bindsym Mod4+a exec qs -c mat-shell ipc call shell toggleControlCenter"));
  assert.ok(swaySnippet(defaultBinds()).includes("qs -c mat-shell ipc call shell openLauncherMode clip"));
  assert.ok(swaySnippet(defaultBinds()).includes("qs -c mat-shell ipc call osd changeVolume 5"));
});

// Contract details beyond the card (02-contracts.md §2.11)

test("ACTIONS: labels, groups, core and repeat flags", () => {
  const byId = Object.fromEntries(ACTIONS.map((a) => [a.id, a]));
  assert.deepEqual(ACTIONS.filter((a) => a.core).map((a) => a.id), ["toggleLauncher", "togglePower", "openSettings"]);
  assert.deepEqual(ACTIONS.filter((a) => a.repeat).map((a) => a.id), ["volumeUp", "volumeDown", "brightnessUp", "brightnessDown"]);
  assert.equal(byId.toggleCapture.label, "Screenshot & recording");
  assert.equal(byId.lock.group, "Session");
  assert.deepEqual(byId.openSettings.ipc, { target: "shell", fn: "openSettings", args: [""] });
  assert.deepEqual(byId.volumeDown.ipc, { target: "osd", fn: "changeVolume", args: ["-5"] });
});

test("defaultBinds: chords from §7.1–§7.2; toggleCalendar is unbound", () => {
  const d = defaultBinds();
  assert.deepEqual(d.toggleLauncher, ["Super", "Super+Space"]);
  assert.deepEqual(d.toggleCapture, ["Print", "Shift+Super+S"]);
  assert.deepEqual(d.toggleCalendar, []);
  assert.deepEqual(d.focusBar, ["Ctrl+Alt+Tab"]);
});

test("normalizeChord: empty and repeated modifiers; other key names keep their case", () => {
  assert.equal(normalizeChord(""), "");
  assert.equal(normalizeChord("super+Super+space"), "Super+space");
  assert.equal(normalizeChord("win+."), "Super+Period");
  assert.equal(normalizeChord("XF86AudioMute"), "XF86AudioMute");
});

test("hyprBindLines: empty chords and lone modifiers other than Super write nothing", () => {
  assert.deepEqual(hyprBindLines("toggleMedia", ""), []);
  assert.deepEqual(hyprBindLines("toggleMedia", "Ctrl"), []);
});

test("bindsConf: one line per chord, in ACTIONS order", () => {
  const lines = bindsConf(defaultBinds()).trimEnd().split("\n");
  assert.equal(lines[1], "bindr = SUPER, Super_L, global, mat-shell:toggleLauncher");
  assert.equal(lines[2], "bind = SUPER, space, global, mat-shell:toggleLauncher");
  assert.equal(lines.length, 1 + 21);
});

test("niriSnippet and swaySnippet: spawn lines, an empty argument as \"\", lone Super skipped", () => {
  const niri = niriSnippet(defaultBinds());
  assert.ok(niri.includes('Mod+A { spawn "qs" "-c" "mat-shell" "ipc" "call" "shell" "toggleControlCenter"; }'));
  assert.ok(niri.includes('Mod+Comma { spawn "qs" "-c" "mat-shell" "ipc" "call" "shell" "openSettings" ""; }'));
  assert.ok(!/^Mod \{/m.test(niri));
  const sway = swaySnippet(defaultBinds());
  assert.ok(sway.includes('bindsym Mod4+comma exec qs -c mat-shell ipc call shell openSettings ""'));
  assert.ok(sway.includes("bindsym Control+Mod1+Tab exec qs -c mat-shell ipc call shell focusBar"));
  assert.ok(sway.endsWith("\n"));
});
