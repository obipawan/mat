#!/usr/bin/env python3
"""check-refs.py — cross-references in the LLD, the plan, and AGENTS.md resolve.

Checks:
  1. `<file> §N.M` references point at a heading that exists (`## N.` / `### N.M`) in that file.
     <file> is `01-architecture.md`, `02-contracts`, `interactions/01`, `SC-02`, `README`, …
  2. A bare `§N` in docs/lld/*.md points at a heading in the same file (skipped after "spec").
  3. `Task N` outside the plan names the task: `Task 11 (runtime spike)`, and every word in the
     parentheses appears in that task's title. Ranges (`Tasks 1–3`) and refs inside the plan only have to exist.
  4. Plan `Depends on` lists earlier, existing tasks.
  5. Every source file the architecture tree and the contracts name is created by exactly one task,
     and every file a task creates under shell/ is in the tree.
"""
import json
import re
import sys
from pathlib import Path

sys.dont_write_bytecode = True  # keep scripts/__pycache__ out of the working tree
sys.path.insert(0, str(Path(__file__).resolve().parent))
import planlib  # noqa: E402

ROOT = planlib.ROOT
LLD = sorted((ROOT / "docs" / "lld").glob("*.md"))
SCANNED = LLD + [planlib.PLAN, ROOT / "AGENTS.md"]
SPEC_FILES = sorted((ROOT / "design-system").rglob("*.md")) + LLD
FILE_REF = r"`?(SC-\d\d|(?:foundations|primitives|interactions|shell-components)/\d\d[\w.-]*|README(?:\.md)?|\d\d-[a-z][\w-]*(?:\.md)?)`?"
SECTION = r"§\s?(\d+(?:\.\d+)*)(?:\s*[–-]\s*§?\s?(\d+(?:\.\d+)*))?"
REF = re.compile(FILE_REF + r"[ ,]*(?:\([^)]*\)\s*)?" + SECTION)
BARE = re.compile(r"(?<![\w`)/.-])(?<![Ss]pec )(?<![Ss]pec's )" + SECTION)


def resolve(tok):
    tok = tok.strip("`")
    if re.fullmatch(r"SC-\d\d", tok):
        hits = sorted((ROOT / "design-system" / "shell-components").glob(tok[3:] + "-*.md"))
    elif "/" in tok:
        folder, num = tok.split("/")[0], tok.split("/")[1][:2]
        hits = sorted((ROOT / "design-system" / folder).glob(num + "-*.md"))
    elif tok.startswith("README"):
        hits = [ROOT / "docs" / "lld" / "README.md"]
    else:
        stem = tok[:-3] if tok.endswith(".md") else tok
        hits = [p for p in SPEC_FILES if p.stem == stem or p.stem.startswith(stem + "-") or p.stem.startswith(stem)]
        hits = [p for p in hits if p.stem == stem] or hits
    return hits[0] if len(hits) == 1 else None


def headings(path, cache={}):
    if path not in cache:
        nums = set()
        for line in path.read_text(encoding="utf-8").splitlines():
            m = re.match(r"#{1,6}\s+§?\s?(\d+(?:\.\d+)*)[.\s]", line + " ")
            if m:
                nums.add(m.group(1))
        cache[path] = nums
    return cache[path]


def main():
    errors = []
    cards = planlib.tasks()
    for doc in SCANNED:
        rel = doc.relative_to(ROOT).as_posix()
        in_code = False
        for n, line in enumerate(doc.read_text(encoding="utf-8").splitlines(), 1):
            if line.startswith("```"):
                in_code = not in_code
            if in_code:
                continue
            spans = []
            for m in REF.finditer(line):
                spans.append(m.span())
                target = resolve(m.group(1))
                if target is None:
                    errors.append(f"{rel}:{n}: `{m.group(1)}` does not name exactly one spec or LLD file")
                    continue
                for sec in filter(None, (m.group(2), m.group(3))):
                    if sec not in headings(target):
                        errors.append(f"{rel}:{n}: {target.relative_to(ROOT)} has no §{sec}")
            if doc in LLD:
                for m in BARE.finditer(line):
                    if any(a <= m.start() < b for a, b in spans):
                        continue
                    for sec in filter(None, (m.group(1), m.group(2))):
                        if sec not in headings(doc):
                            errors.append(f"{rel}:{n}: bare §{sec} but this file has no such heading (name the file)")
            for m in re.finditer(r"\bTasks? (\d+)(?:\s*(?:–|-|and|,)\s*(\d+))?(?:\s*\(([^)]*)\))?", line):
                nums = [int(x) for x in (m.group(1), m.group(2)) if x]
                for t in nums:
                    if t not in cards:
                        errors.append(f"{rel}:{n}: Task {t} does not exist (the plan has {len(cards)})")
                if doc == planlib.PLAN or len(nums) != 1 or nums[0] not in cards:  # ranges ("Tasks 1–3") name no single task
                    continue
                title_words = set(re.findall(r"[a-z0-9]+", cards[nums[0]]["title"].lower()))
                words = set(re.findall(r"[a-z0-9]+", (m.group(3) or "").lower()))
                if not words or not words <= title_words:
                    errors.append(f"{rel}:{n}: write `Task {nums[0]} (<words from its title>)`; title is "
                                  f"\"{cards[nums[0]]['title']}\"")
    for t, card in cards.items():
        for d in card["depends"]:
            if d not in cards or d >= t:
                errors.append(f"plan: Task {t} depends on Task {d}, which is not an earlier task")
    # 5. tree / contracts <-> plan coverage
    arch = (ROOT / "docs" / "lld" / "01-architecture.md").read_text(encoding="utf-8")
    tree = arch.split("├── shell/", 1)[1].split("├── tests/", 1)[0]
    tree = "\n".join(line.split("#")[0] for line in tree.splitlines())  # names in tree comments are placeholders
    expected = set(re.findall(r"\b([A-Za-z]\w*\.(?:qml|mjs))\b", tree))
    contracts = json.loads((ROOT / "docs" / "lld" / "contracts.json").read_text(encoding="utf-8"))
    expected |= {p + ".qml" for p in contracts["primitives"]} | set(contracts["widgets"].values())
    expected |= {Path(m).name for m in contracts["lib"]} | {Path(s["file"]).name for s in contracts["singletons"].values()}
    created = {}
    for t, card in cards.items():
        for p in card["files"]["create"]:
            if p.startswith("shell/") and p.endswith((".qml", ".mjs")):
                created.setdefault(Path(p).name, []).append(t)
    for name in sorted(expected - set(created)):
        errors.append(f"plan: no task creates {name} (named in 01-architecture.md §1 or contracts.json)")
    for name in sorted(set(created) - expected):
        errors.append(f"plan: Task {created[name][0]} creates {name}, which 01-architecture.md §1 does not list")
    for name, ts in sorted(created.items()):
        if len(ts) > 1:
            errors.append(f"plan: {name} is created by Tasks {ts} (exactly one task owns a file)")
    if errors:
        print("ERROR: broken cross-references:")
        for e in errors:
            print("       " + e)
        sys.exit(1)
    print(f"  ✓ check-refs: § and Task references resolve in {len(SCANNED)} documents; "
          f"{len(created)} shell files each owned by one task")


if __name__ == "__main__":
    main()
